# Copy to .env only if you need to override defaults. Never publish .env.
# A random session secret is generated automatically in database/.secret_key.
# SECRET_KEY=replace-with-a-long-random-value
HOST=127.0.0.1
PORT=5001
PUBLIC_BASE_URL=http://127.0.0.1:5001
# To use a phone: HOST=0.0.0.0 and set Settings > QR base URL to your Mac's LAN IP.
# PUBLIC_BASE_URL is the initial seed URL; later changes belong in Admin Settings.
# DATABASE_URL=mysql+pymysql://user:password@localhost/smart_restaurant?charset=utf8mb4

# Local-demo table selection without a QR. Set 0 for QR-only table access.
ENABLE_TABLE_PICKER=1
